<?xml version="1.0" encoding="UTF-8"?>

<handout xml:id="pp-2">
    <title>Portfolio Problem 2</title>

    <theorem>
        <statement>
            <p>
                If <m>n</m> is an even integer, then <m>n^{2} + 8n + 9</m> is an
                odd integer.
            </p>
        </statement>
    </theorem>

    <paragraphs>
        <title>Instructions for the draft</title>

        <p>
            Upload a scanned image of your draft to the Blackboard assignment.
            Typically drafts are handwritten!
        </p>
    </paragraphs>

    <p>
        <ol>
            <li>
                <p>
                    <em>Prove the theorem above.</em> Include all key
                    mathematical ideas and work so that you have a complete
                    solution.
                    Include just enough writing and detail to make it
                    understandable.
                    Drafts can be hand-written -- don't focus on writing
                    guidelines nor typing them up yet.
                </p>
            </li>

            <li>
                <p>
                    <em>Include examples.</em> Substitute in a variety of
                    appropriate values for <m>n</m> to see how this theorem
                    works.
                    Include at least 3 examples, covering a variety of
                    <m>n</m>-values.
                    For each, show how you know the hypothesis and conclusion
                    are true (see the
                    <url href="https://www.overleaf.com/read/tywmwskbkzpf#82a23f">sample portfolio solution</url>
                    for an example of how to format these).
                </p>
            </li>
        </ol>
    </p>

    <paragraphs>
        <title>Instructions for the writing revision</title>

        <p>
            First, wait for draft feedback on Blackboard!
        </p>

        <p>
            Then, type your proof in Overleaf and submit a PDF of your writing
            revision to the Blackboard assignment.
        </p>

        <p>
            <ol>
                <li>
                    <p>
                        Include a formal proof of Theorem 1.
                    </p>
                </li>

                <li>
                    <p>
                        Include examples, same as in the draft.
                    </p>
                </li>

                <li>
                    <p>
                        Address all feedback from the draft.
                    </p>
                </li>

                <li>
                    <p>
                        Type your work in <latex/>.
                    </p>
                </li>

                <li>
                    <p>
                        Include a <q>view only</q> link to your Overleaf
                        document in the Blackboard submission's text field.
                    </p>
                </li>

                <li>
                    <p>
                        Follow <em>all</em> of the conventions listed below
                        (click each one to get more details and examples):
                    </p>
                </li>
            </ol>
        </p>
    </paragraphs>

    
