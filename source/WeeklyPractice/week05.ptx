    <page>
    <exercise workspace=".75in">
        <title>Exercise 3.4</title>
        
        
        <introduction>
            <p>
                 Suppose <m>A = \{1,2,3,4,5\}</m>, <m>B=
                \{3,4,5,6,7\}</m>, <m>C = \{1,3,5,7\}</m>, and the universal set is <m>U =
                \{1,2,3,4,5,6,7,8\}</m>.
                Determine the following.
                
            </p>
        </introduction>

        <task>
            <statement>
                <p>
                   <m>A\cup B</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>B\cap C</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   <m>A\backslash C </m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   <m> (C\backslash A)^c</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(A\cup B\cup C)^c</m>
                </p>
            </statement>
        </task>
    </exercise>
 </page>

