<?xml version="1.0" encoding="UTF-8"?>

<handout xml:id="WP-05">
    <title>Week 5 Weekly Practice</title>
<page>
    

    <p>
        Due the second class of the week of October 5.
    </p>

    <exercise workspace=".25in">
        <introduction>
            <p>
                <term>Exercise 3.3</term>.
               Rewrite each of the following sets by listing their elements
                between braces (roster notation).
                If it is an infinite set, write out enough elements for the
                reader to see the pattern, then use ellipses.
            </p>
        </introduction>

        <task>
            <statement>
                <p>
                    <m>\{n\in\mathbb{N}: -5\leq n &lt; 4 \}</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m> \{1,3,4,5\} \times \{😀, math\} </m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>\emptyset \times \{1,2,3\}</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>\mathcal{P}(\{a,2, \square\})</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>\{5n+3: n\in\mathbb{Z}\}</m>
                </p>
            </statement>
        </task>
    </exercise>

    </page>

    <page>
    <exercise workspace=".75in">
        <introduction>
            <p>
                <term>Exercise 3.4</term> Suppose <m>A = \{1,2,3,4,5\}</m>, <m>B=
                \{3,4,5,6,7\}</m>, <m>C = \{1,3,5,7\}</m>, and the universal set is <m>U =
                \{1,2,3,4,5,6,7,8\}</m>.
                Determine the following.
                
            </p>
        </introduction>

        <task>
            <statement>
                <p>
                   <m>A\cup B</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>B\cap C</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   <m>A\backslash C </m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   <m> (C\backslash A)^c</m>
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    <m>(A\cup B\cup C)^c</m>
                </p>
            </statement>
        </task>
    </exercise>
 </page>

    <page>
    <exercise workspace="1in">
        <introduction>
            <p>
                Rewrite each of the following sets in set-builder notation.
            </p>
        </introduction>

        <task>
            <statement>
                <p>
                    <m>\{3,5,7,9,11,\dots\}</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   <m> \{ \dots, -\frac{3\pi}{2}, -\pi, -\frac{\pi}{2}, 0, \frac{\pi}{2}, \pi, \frac{3\pi}{2}, \dots\}</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                <m> \{-2,-1,0,1,2,3,4,5\}</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>\{\dots, -\frac{8}{27}, -\frac{4}{9}, -\frac{2}{3}, 1, \frac{2}{3}, \frac{4}{9}, 
                        \frac{8}{27},\dots\}</m>
                </p>
            </statement>
        </task>
    </exercise>
 </page>

    <page>
    <exercise workspace="1in">
        <introduction>
            <p>
              Determine whether each of the following are true or false.  
            </p>
        </introduction>
               <task>
                <statement>
                    <p>
                        <m>1\in \{1, \{1\}\}</m>
                    </p>
                </statement>
               </task>

               <task>
                <statement>
                    <p>
                          <m>1\subseteq \{1, \{1\}\}</m>
                    </p>
                </statement>
               </task>

               <task>
                <statement>
                    <p>
                          <m>\{1\}\in \{1, \{1\}\}</m>
                    </p>
                </statement>
               </task>
         
                 <task>
                <statement>
                    <p>
                          <m>\{1\}\subseteq \{1, \{1\}\}</m>
                    </p>
                </statement>
               </task>

               <task>
                <statement>
                    <p>
                        <m>\emptyset\in\mathbb{N}</m>
                    </p>
                </statement>
               </task>

               <task>
                <statement>
                    <p>
                        <m>\emptyset \subseteq \in\mathbb{N}</m>
                    </p>
                </statement>
               </task>

               <task>
                <statement>
                    <p>
                    <m>\emptyset \in \mathcal{P}(\mathbb{N})</m>
                    </p>
                </statement>
               </task>
    </exercise>
     </page>

    <page>

    <exercise>
        <statement>
            <p>
                Prove that <m>\{12a + 3b: a, b\in\mathbb{Z}\} = \{3k: k\in\mathbb{Z}\}</m>.
            </p>
        </statement>
    </exercise>

</page>
</handout>