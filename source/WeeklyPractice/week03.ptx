<?xml version="1.0" encoding="UTF-8"?>

<handout xml:id="WP-03">
    <title>Week 3 Weekly Practice</title>

   
        <p>
            Due the second class of the week of September 22.
        </p>

        <exercise workspace="6in">
            <title>Exercise 2.8 (a)</title>

            <statement>
                <p>
                    Prove that if <m>n</m> is an integer, then <m> 3n^2+5n+1 </m>
                    is an odd integer.
                </p>
            </statement>
        </exercise>

        
   
        <exercise workspace="1.5in">
            <title>Exercise 2.16</title>

            <introduction>
                <p>
                    For each pair of integers, find the unique quotient and
                    remainder when <m>a</m>is divided by <m>m</m>.
                    Then, write your answer as a congruence.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        <m>a=15, m=4 </m>
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        <m>a=4, m=15</m>
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        <m>a=-7, m=3</m>
                    </p>
                </statement>
            </task>
        </exercise>
  
        <exercise workspace="1.5in">
            <title>Congruence Facts</title>

            <introduction>
                <p>
                    In this problem, you will prove congruence acts a lot like
                    “=”.
                    Prove the following:
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        For all integers <m>a</m> and all natural numbers <m>m</m>, <m>a \equiv a \pmod{m}</m>
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        For all integers <m>a</m> and <m>b</m>, and all natural numbers m, if
                        <m>a \equiv b \pmod{m}</m> then <m>b \equiv a \pmod{m}</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        For all integers <m>a,b,</m> and <m>c</m>, and all natural numbers <m>m</m>,
                        if <m>a \equiv b\pmod{m}</m>and <m>b \equiv c\pmod{m}</m> then<m>a \equiv c\pmod{m}</m>.
                    </p>
                </statement>
            </task>
        </exercise>

        <exercise workspace = "1in">
            <title>A Reflection on Class So Far</title>
            
            
            <task>
                <statement>
                    <p>
                      What are 3 things you've learned so far in MTH 210?  
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        What are 2 things you are still working on understanding?
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        What is 1 thing that you have enjoyed the most in MTH 210 so far?
                    </p>
                </statement>
            </task>
        </exercise>

</handout>