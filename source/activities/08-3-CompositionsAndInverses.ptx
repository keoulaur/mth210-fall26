    </p>

</activity>

    
    <theorem xml:id="ch08-thm-compinjginj">
        <statement>
            <p>
                Suppose <m>A,B,</m> and <m>C</m> are sets, and <m>g: A\to B</m>
                and <m>f: B\to C</m> are functions.
                If <m>f\circ g</m> is injective, then <m>g</m> is injective.
            </p>
        </statement>
    </theorem>

    <activity>
