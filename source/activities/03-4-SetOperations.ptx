<?xml version="1.0" encoding="UTF-8"?>

<handout>
    <title>Operations on Sets</title>

    <activity>
        <introduction>
            <p>
                One learning target is
                <q> given two sets and a universal set identify the union, intersection, complement, and set difference. Find the power set of a given set.</q>
                Here's some practice with that, plus a bonus on Cartesian
                product.
            </p>
        </introduction>

        <task workspace=".5in">
            <introduction>
                <p>
                    Let <m>U = \{ x \in \mathbb{N}: x \leq 10\}</m>.
                    Let <m>A = \{2,4,6,8,10\}</m> and <m>B = \{1,3\}</m>.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        Find <m>A\cap B</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find <m>A^C</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find <m>A \setminus B</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find <m>\mathcal{P}(B)</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find <m>A \times B</m>.
                    </p>
                </statement>
            </task>
        </task>

        <task workspace=".5in">
            <introduction>
                <p>
                    Let <m>U = \mathbb{Z}</m>.
                    Let <m>X = \{ x\in\mathbb{Z}: x \equiv 0 \pmod{4}</m> and
                    <m>Y = \{x\in\mathbb{Z}: x \equiv 1\pmod{3}\}</m>.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        Find at least 3 elements in <m>A\cup B</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find at least 3 elements in <m>A\cap B</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find at least 3 elements in <m>A^C</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find at least 3 elements in <m>A \setminus B</m>.
                    </p>
                </statement>
            </task>

            <task>
                <statement>
                    <p>
                        Find at least 3 elements in <m>B\setminus A</m>.
                    </p>
                </statement>
            </task>
        </task>
    </activity>

    <paragraphs>
        <title>DeMorgan's Laws</title>

        <p>
            DeMorgan's Laws are an important notion about taking complements of
            unions and intersections.
        </p>
    </paragraphs>

    <activity>
        <p>
            In each of the following Venn diagrams, shade <m> (A\cap B)^C </m>,
            <m> A^c \cap B^c </m>, <m> (A\cup B)^C </m>, and
            <m>A^C \cup B^C</m>.
        </p>

        <figure xml:id="fig-venn">
            <caption>Venn diagrams for shading</caption>
            <sidebyside widths="25% 25% 25% 25%">
                <image>
                    <shortdescription>A Venn diagram</shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefig-venn1">
                        <diagram dimensions="(300,180)" margins="5">
                            <coordinates bbox="(0,0,10,6)">
                                <define-shapes>
                                    <circle at="A" center="(4,3)" radius="2"/>
                                    <circle at="B" center="(6,3)" radius="2"/>
                                </define-shapes>
                                <shape shape="A" stroke="black"/>
                                <shape shape="B" stroke="black"/>
                                <rectangle lower-left="(0,0)" dimensions="(10,6)" stroke="black"/>
                                <label anchor="(2,3)" alignment="nw">
                                    <m>
                                        A
                                    </m>
                                </label>
                                <label anchor="(8,3)" alignment="ne">
                                    <m>
                                        B
                                    </m>
                                </label>
                                <label anchor="(9,5)" alignment="ne">
                                    <m>
                                        U
                                    </m>
                                </label>
                            </coordinates>
                        </diagram>
                    </prefigure>
                </image>

                <image>
                    <shortdescription>A Venn diagram</shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefig-venn2">
                        <diagram dimensions="(300,180)" margins="5">
                            <coordinates bbox="(0,0,10,6)">
                                <define-shapes>
                                    <circle at="A" center="(4,3)" radius="2"/>
                                    <circle at="B" center="(6,3)" radius="2"/>
                                </define-shapes>
                                <shape shape="A" stroke="black"/>
                                <shape shape="B" stroke="black"/>
                                <rectangle lower-left="(0,0)" dimensions="(10,6)" stroke="black"/>
                                <label anchor="(2,3)" alignment="nw">
                                    <m>
                                        A
                                    </m>
                                </label>
                                <label anchor="(8,3)" alignment="ne">
                                    <m>
                                        B
                                    </m>
                                </label>
                                <label anchor="(9,5)" alignment="ne">
                                    <m>
                                        U
                                    </m>
                                </label>
                            </coordinates>
                        </diagram>
                    </prefigure>
                </image>

                <image>
                    <shortdescription>A Venn diagram</shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefig-venn3">
                        <diagram dimensions="(300,180)" margins="5">
                            <coordinates bbox="(0,0,10,6)">
                                <define-shapes>
                                    <circle at="A" center="(4,3)" radius="2"/>
                                    <circle at="B" center="(6,3)" radius="2"/>
                                </define-shapes>
                                <shape shape="A" stroke="black"/>
                                <shape shape="B" stroke="black"/>
                                <rectangle lower-left="(0,0)" dimensions="(10,6)" stroke="black"/>
                                <label anchor="(2,3)" alignment="nw">
                                    <m>
                                        A
                                    </m>
                                </label>
                                <label anchor="(8,3)" alignment="ne">
                                    <m>
                                        B
                                    </m>
                                </label>
                                <label anchor="(9,5)" alignment="ne">
                                    <m>
                                        U
                                    </m>
                                </label>
                            </coordinates>
                        </diagram>
                    </prefigure>
                </image>

                <image>
                    <shortdescription>A Venn diagram</shortdescription>
                    <prefigure xmlns="https://prefigure.org" label="prefig-venn4">
                        <diagram dimensions="(300,180)" margins="5">
                            <coordinates bbox="(0,0,10,6)">
                                <define-shapes>
                                    <circle at="A" center="(4,3)" radius="2"/>
                                    <circle at="B" center="(6,3)" radius="2"/>
                                </define-shapes>
                                <shape shape="A" stroke="black"/>
                                <shape shape="B" stroke="black"/>
                                <rectangle lower-left="(0,0)" dimensions="(10,6)" stroke="black"/>
                                <label anchor="(2,3)" alignment="nw">
                                    <m>
                                        A
                                    </m>
                                </label>
                                <label anchor="(8,3)" alignment="ne">
                                    <m>
                                        B
                                    </m>
                                </label>
                                <label anchor="(9,5)" alignment="ne">
