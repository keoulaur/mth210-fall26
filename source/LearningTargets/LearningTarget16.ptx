        </exercise>

        <exercise>
            <introduction>
                <p>
                      For each of the following statements, state what you would assume in a proof by contradiction.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>For all <m>n\in\mathbb{Z}</m>, if <m>n</m> is odd, then <m>n</m> cannot be
                                        expressed as the sum of <m>3</m> even integers.
                        
                    </p>
                </statement>
                <solution>
                   <p>
                    
                   </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                         For all <m>a,b\in \mathbb{R}</m>, if <m>a\neq 0</m> and <m>b\neq 0</m> then
                                                  <m>(a+b)^{2}\neq a^{2} + b^{2}</m>.
                    </p>
                </statement>
                <solution>
                    <p>
                                   </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                       For all <m>x,y\in\mathbb{R}</m>, if <m>x</m> and <m>y</m> are positive,
                                               <m>x-4y&lt;y-3x</m> and <m>3x&gt;2y</m> then <m>12x^{2}+10y^{2}&lt;24xy</m>.
                    </p>
                </statement>
                <solution>
                    <p>
                       There exists <m>r\in \mathbb{R}</m> such that <m>r&gt; 2</m> and  <m>r^2 \leq 4</m>.
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                         For all natural numbers <m>p</m> and <m>q</m>, if <m>p</m> and <m>q</m> are twin
                                                  primes other than <m>3</m> and <m>5</m>, then <m>pq+1</m> is a perfect square
                                                  and <m>36</m> divides <m>pq+1</m>.
                    </p>
                </statement>
                <solution>
                    <p>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                         For every real number <m>x</m>, there exists a
                                       real number <m>y</m> such that <m>x + y = 0</m>. 
                    </p>
                </statement>
                <solution>
                    <p>
                    </p>
                </solution>
            </task>
      
   
                  
                         

             </exercise>

             <exercise>
