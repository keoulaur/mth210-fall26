                                                </solution>

                    </task>

                    <task>
                          <statement>
                        <p>
                            For all real numbers $x, y,$ and $z$, if $|x-y|&lt; 4$ and $|y-z| &lt; 4$ then $|x-z|&lt;4$.
                        </p>
                                                </statement>
                                                <solution>
