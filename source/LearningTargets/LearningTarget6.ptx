<?xml version="1.0" encoding="UTF-8"?>

<handout>
    <title>Learning Target 6 Practice</title>

    <p>
        <em>Create and translate sets using set builder notation and fluently work with sets written in set builder notation.</em>
    </p>

    <paragraphs>
        <title>Need to know</title>

        <p>
            <ul>
                <li>
                    <p>
                        Given a set in set-builder notation, write in roster notation (if possible).
                    </p>
                </li>

                <li>
                    <p>
                        Given a set in roster notation, write in set-builder notation.
                    </p>
                </li>
            </ul>
        </p>
    </paragraphs>

    <paragraphs>
        <title>Practice From Class/Homework</title>

    <p>
        


            <ol>
                <li>
                    <p>
                        Weekly Practice 5 Exercsie 3.3 (a) and (e) and  Weekly Practice 5 Exercise 3.5 (all parts)
            
                    </p>
                </li>
             
                       

                <li>
                    <p>
                        Worksheets page 41.
                    </p>
                </li>
            </ol>
             </p>
        </paragraphs>
        <paragraphs>
            <title>Practice Questions</title>
            
        <exercise>
            <introduction>
                <p>
                    Write the following sets in roster notation (if possible).
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>A = \{5n+6: n\in \mathbb{N} \text{ and } n \text{ is even } \}</m>
                    </p>
                </statement>
                <solution>
                <p>
                   <m>A = \{16,26,36,46,\dots \}</m>
                </p>
            </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>B = \{x\in \mathbb{Z}: x^2>100\}</m>
                    </p>
                </statement>
                   <solution>
                <p>
                    <m>B = \{\dots, -12,-11, -10, 10,11,12,13,\dots\}</m>
                </p>
            </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>C = \{n\in \mathbb{Z}: -5\leq n &lt; 4\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>C = \{-5,-4,-3,-2,-1,0,1,2,3\}</m>
                    </p>
                </solution>
            </task>
         
            
         <task>
            <statement>
                <p>
                  <m>D = \{n\in \mathbb{N}: -5 \leq n &lt; 4\}</m>  
                </p>
            </statement>
            <solution>
                <p>
                    <m>D=\{1,2,3\}</m>
                </p>
            </solution>
         </task>

         <task>
            <statement>
                <p>
                    <m>E = \{n^2: n\in \mathbb{N}\}</m>
                </p>
            </statement>

            <solution>
                <p>
                    <m>E=\{1,4,9,16,25,\dots\}</m>
                </p>
            </solution>
         </task>

         <task>
            <statement>
                <p>
                    <m>F = \{n\in \mathbb{N}: n = x^2 \text{ for some } x\in \mathbb{N}\}</m>
                </p>
            </statement>

            <solution>
                <p>
                    <m>F=\{1,4,9,16,25,\dots\}</m>
                </p>
            </solution>
         </task>

         <task>
            <statement>
                <p>
                    <m>G = \{x\in\mathbb{R}: x^2+5x+6 = 0\}</m>
                </p>
            </statement>
            <solution>
                <p>
                    <m>G=\{-3,-2\}</m>
                </p>
            </solution>
         </task>

         <task>
            <statement>
                <p>
                    <m> H = \{\frac{m}{n} \in \mathbb{Q}: |\frac{m}{n}| &lt; 1 \text{ and } 1\leq n \leq 4 \}</m>
                </p>
            </statement>

            <solution>
                <p>
               <m> H=\{ \frac{1}{2}, \frac{1}{3}, \frac{1}{4}, \frac{2}{3}, \frac{3}{4} \}</m>     
                </p>
            </solution>
         </task>

         <task>
            <statement>
                <p>
                <m>I = \{x\in \mathbb{R}: |x|&lt; 1\}</m>
                </p>
            </statement>
            <solution>
                <p>
                    This one is impossible! This is all real numbers strictly between <m>-1</m> and <m>1</m>.
                    but there's no way to list all the real numbers, or create a pattern of them in a list.
                </p>
            </solution>
         </task>
      

            
        </exercise>

        <exercise>
          <introduction>
            <p>
                Write the following in set-builder notation. Note there are many possible answers!
            </p>
          </introduction>

          <task>
            <statement>
                <p>
                    <m>S</m> is the set of all integers that are a perfect square, i.e., <m>S = \{0,1,4,9,16,\dots\}</m>
                </p>
            </statement>
            <solution>
                <p>
                    <m>\{n^2: n\in\mathbb{N}\}</m>
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>T = \{\dots, -8,-4,0,4,8,12,16,\dots \}</m>
                </p>
            </statement>
            <solution>
                <p>
                  <m>T = \{4n: n\in \mathbb{Z}\}</m>  
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>U = \{\dots, -7, -3, 1,5,9,13,17,\dots\}</m>
                </p>
            </statement>

            <solution>
                <p>
                    <m>U = \{4n+1: n\in\mathbb{Z}\}</m> or <m>U = \{ n\in \mathbb{Z} : n\equiv 1 \pmod{4}\}</m>
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>V</m> is the set of all real numbers <m>x</m> for which <m>\sec(x) = \frac{1}{3}</m> (do not actually
                    find these!)
                </p>
            </statement>
            <solution>
                <p>
                    <m>V = \{ x\in \mathbb{R} : \sec(x) = \frac{1}{3}\}</m>
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>W = \{-2,-1,0,1,2,3,4,5\}</m>
                </p>
            </statement>
            <solution>
                <p>
                    <m>W = \{x\in \mathbb{Z} : -2 \leq x \leq 5\}</m>
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>Y</m> is the set of all integers congruent to <m>1</m> modulo <m>5</m>
                </p>
            </statement>
            <solution>
                <p> <m>Y = \{n\in\mathbb{Z}: n\equiv 1 \pmod{5} \}</m>
                    
                </p>
            </solution>
          </task>

          <task>
            <statement>
                <p>
                    <m>Z = \{ \frac{1}{2}, \frac{2}{3}, \frac{3}{4}, \frac{4}{5}, \dots\} </m>
                </p>
            </statement>
            <solution>
                <p>
                    <m>Z = \left\{ \frac{n}{n+1} : n\in\mathbb{N}\right\}</m>
                </p>
            </solution>
          </task>
</exercise>

    </paragraphs>
</handout>