<?xml version="1.0" encoding="UTF-8"?>

<handout>
    <title>Learning Target 7 Practice</title>

    <p workspace=".2in">
        <em>Use the symbols related to sets (like <m>\in, \notin, \subseteq, \subset, =, \not\subseteq</m>)</em>
        correctly. The question may ask you for one appropriate symbol, or all the symbols that work!
    </p>

    <paragraphs>
        <title>Need to know</title>

        <p>
            <ul>
                <li>
                    <p>
                        What each symbol in the list means!
                    </p>
                </li>

                <li>
                    <p>
                        How to deal with sets inside of sets.
                    </p>
                </li>
            </ul>
        </p>
    </paragraphs>

    <paragraphs>
        <title>Practice:</title>

        <exercise>
            <introduction>
                <p>
                    Let <m>A = \{3k: k\in \mathbb{Z}\}</m>,
                    <m>B = \{ n\in\mathbb{Z}: n^2 \le 36\}</m>,
                    <m>C = \{-2,0,5\}</m>.
                    Fill in the blanks with an appropriate symbol from the list
                    <m>\in, \notin, \subset, =, \not\subseteq</m>.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        <m>C </m> <fillin characters="8"/> <m> B</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>C \subseteq, \subset, \notin B</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>9</m> <fillin characters="8"/> <m>A</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>9\in,\not\subseteq A</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{9\}</m> <fillin characters="8"/> <m>A</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\{9\}\subseteq, \subset, \notin A</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{5,0,0,-2\}</m> <fillin characters="8"/> <m>C</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\{5,0,0,-2\} =,\subseteq,\notin </m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>10</m> <fillin characters="8"/> <m>B</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>10 \in, \not\subseteq B</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>B</m> <fillin characters="8"/> <m>A</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>B \not\subseteq, \notin A</m>
                    </p>
                </solution>
            </task>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    Fill in the following blanks with all appropriate symbols
                    from the list <m>\in, \notin, \subset, =, \not\subseteq</m>.
                </p>
            </introduction>

            <task>
                <statement>
                    <p>
                        <m>1</m> <fillin characters="8"/> <m>\{1,2\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\in,\ \not\subseteq</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{1\}</m> <fillin characters="8"/> <m>\{1,2\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\subset,\ \subseteq,\ \notin</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>1</m> <fillin characters="8"/>
                        <m>\{\{1\}, \{2\}\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\notin,\ \not\subseteq</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{1\}</m> <fillin characters="8"/>
                        <m>\{\{1\}, \{2\}\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\in,\ \not\subseteq</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{1,2\}</m> <fillin characters="8"/>
                        <m>\{\{1\}, \{2\}\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\notin,\ \not\subseteq</m>
                    </p>
                </solution>
            </task>

            <task>
                <statement>
                    <p>
                        <m>\{\{1\}\}</m> <fillin characters="8"/>
                        <m>\{\{1\}, \{2\}\}</m>
                    </p>
                </statement>

                <solution>
                    <p>
                        <m>\subset,\ \subseteq,\ \notin</m>
                    </p>
                </solution>
            </task>
        </exercise>
    </paragraphs>
</handout>